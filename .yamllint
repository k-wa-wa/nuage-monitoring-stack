extends: default

ignore: |
  charts/
  **/charts/

rules:
  line-length: disable
  document-start: disable
  empty-lines: disable
  trailing-spaces: disable
  indentation:
    indent-sequences: whatever
  comments:
    min-spaces-from-content: 1
  braces:
    ignore: |
      k8s/ssvc/declarations/
  colons:
    ignore: |
      k8s/ssvc/declarations/
